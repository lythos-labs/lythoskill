#!/bin/sh
# pre-push — semgrep fast QA scan + push skills branch alongside main

remote="$1"
url="$2"

# 0. Semgrep fast pattern scan (CodeQL runs in CI — see ADR-20260512002131099)
if command -v semgrep >/dev/null 2>&1; then
  echo "🔍 semgrep QA scan..."
  semgrep --config=p/security-audit --config=p/secrets --metrics=off --quiet packages/ 2>&1
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ semgrep found issues. Fix before pushing."
    echo "   Run 'semgrep --config=p/security-audit --config=p/secrets --metrics=off packages/' to see details."
    exit 1
  fi
  echo "✅ semgrep: 0 findings"
else
  echo "⚠️  semgrep not installed — skipping pre-push QA scan"
  echo "   Install: brew install semgrep"
fi

# 1. Governance waterline + CLI change awareness
#    Agents see git changes — tip about what to verify before pushing.
echo ""
CHANGED_CLI=$(git diff --name-only origin/main...HEAD 2>/dev/null | grep -E '^packages/[^/]+/src/' | grep -v '\.test\.ts$' || true)
CHANGED_SKILL=$(git diff --name-only origin/main...HEAD 2>/dev/null | grep -E '^packages/[^/]+/skill/' || true)

if [ -n "$CHANGED_CLI" ] || [ -n "$CHANGED_SKILL" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  🧠 CLI / Skill source changed — agent self-check:         ║"
  if [ -n "$CHANGED_CLI" ]; then
    echo "║                                                              ║"
    echo "║  CLI surface modified. Before pushing, verify:               ║"
    echo "║    1. Tests pass for changed packages                        ║"
    echo "║    2. README.md updated if public CLI surface changed        ║"
    echo "║    3. ADR accepted if this implements a proposed decision    ║"
    echo "║    4. Intent/plan/execute separation holds (IO not inlined)  ║"
    echo "║                                                              ║"
  fi
  if [ -n "$CHANGED_SKILL" ]; then
    echo "║  SKILL.md source changed — skill rebuild will auto-run on    ║"
    echo "║  next commit. If desc changed, arena verify before push.     ║"
  fi
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
fi

# 2. Entropy check — weekly governance debt scan
#    Non-blocking by default. Writes .last-entropy-check (gitignored) to survive
#    across sessions. Over 7 days since last check → full scan. Under 7 days → skip.
if [ -f scripts/entropy-check/index.ts ]; then
  bun scripts/entropy-check/index.ts
fi

# 3. Cortex probe — surface state drift the agent should address
if [ -f packages/lythoskill-project-cortex/src/cli.ts ]; then
  bun packages/lythoskill-project-cortex/src/cli.ts probe 2>&1 | grep -E "📭|⚠️.*proposed|⚠️.*in review|⚠️.*active epic" || true
fi

MAX_RETRIES=3
RETRY_DELAY=2

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_ref" = "refs/heads/main" ]; then
    if git show-ref --verify --quiet refs/heads/skills; then
      echo "🚀 Pushing skills branch to $remote..."
      for i in $(seq 1 $MAX_RETRIES); do
        if git push -f "$remote" refs/heads/skills 2>/dev/null; then
          echo "✅ Skills branch synced"
          break
        fi
        if [ $i -lt $MAX_RETRIES ]; then
          echo "⏳ Skills push conflict (attempt $i/$MAX_RETRIES), retrying in ${RETRY_DELAY}s..."
          sleep $RETRY_DELAY
          git fetch "$remote" refs/heads/skills 2>/dev/null
          git update-ref refs/heads/skills FETCH_HEAD 2>/dev/null
        else
          echo "⚠️  Skills push failed after $MAX_RETRIES attempts — proceeding anyway"
        fi
      done
    fi
  fi
done
