#!/bin/sh
# Pre-commit: ADR compliance + auto-rebuild skills + cortex governance (TypeScript)

# 0. Guard-script sensitivity check — warn when modifying meta-layer guards
STAGED_GUARDS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(\.husky/|scripts/pre-commit-|scripts/test-report|scripts/check-path-safety|scripts/adr-check)' || true)

if [ -n "$STAGED_GUARDS" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ⚠️  GUARD-SCRIPT MODIFICATION DETECTED                     ║"
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Bugs in these files cascade silently — the guard itself    ║"
  echo "║  fails and you won't know until the next incident.          ║"
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Changed:                                                   ║"
  for f in $STAGED_GUARDS; do
    printf "║    - %-54s ║\n" "$f"
  done
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Before committing, QA the change:                          ║"
  echo "║    bunx @lythos/skill-arena@latest single                   ║"
  echo "║      --deck examples/decks/qa-sweep.toml                    ║"
  echo "║      --brief 'QA: verify <guard> catches deliberate fail'   ║"
  echo "║  See: AGENTS.md → Guard-script sensitivity                  ║"
  echo "║  Wiki: git-provenance-over-design-assumption-lesson.md      ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
fi

# 0.5. Cortex file renames — must use CLI, not manual mv
STAGED_CORTEX_RENAMES=$(git diff --cached --name-status --diff-filter=R | grep -E '^R.*cortex/(tasks|epics)/' || true)

if [ -n "$STAGED_CORTEX_RENAMES" ]; then
  RENAME_COUNT=$(echo "$STAGED_CORTEX_RENAMES" | wc -l | tr -d ' ')
  echo ""
  echo "📂 ${RENAME_COUNT} cortex file(s) renamed — assuming CLI-driven (probe is the real gate)."
  echo "   If manual: git reset HEAD <file> — then use cortex CLI to move it."
fi

# 0.6. Workspace internal deps MUST use workspace:*, not semver
STAGED_PKG_JSON=$(git diff --cached --name-only --diff-filter=ACM | grep '^packages/.*/package\.json$' || true)

if [ -n "$STAGED_PKG_JSON" ]; then
  BAD_DEPS=$(grep -n '"@lythos/[^"]*":\s*"\^' $STAGED_PKG_JSON 2>/dev/null || true)
  if [ -n "$BAD_DEPS" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ SEMVER ON INTERNAL @lythos DEP — USE workspace:*       ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Workspace-internal dependencies must use workspace:*,     ║"
    echo "║  never ^0.x.y. Semver resolves to stale npm cache — local  ║"
    echo "║  source changes become invisible to dependent packages.    ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "$BAD_DEPS" | while read line; do
      printf "║    %-54s ║\n" "$line"
    done
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Fix: change \"^0.x.y\" → \"workspace:*\" in the files above.  ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
fi

# 0.7. No cross-package relative imports in packages/*/src/
#      Per ADR-20260513041030769. Pattern `from '../../<other-pkg>/src/'`
#      ships broken to npm because npm publish does not include sibling
#      packages in the tarball — external consumers cannot resolve the
#      path. Must use the workspace dep instead:
#        import { x } from '@lythos/<other-pkg>'
#      The publish-time rewriter translates workspace:* → ^version
#      for the published manifest.
STAGED_TS_SRC=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^packages/[^/]+/src/.*\.ts$' \
  | grep -v '\.test\.ts$' || true)

if [ -n "$STAGED_TS_SRC" ]; then
  BAD_IMPORTS=$(grep -nE "from\s+['\"]\.\./\.\./[^'\"]+/src/" $STAGED_TS_SRC 2>/dev/null || true)
  if [ -n "$BAD_IMPORTS" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ CROSS-PACKAGE RELATIVE IMPORT — USE WORKSPACE DEP      ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Pattern \`from '../../<pkg>/src/'\` ships broken to npm:    ║"
    echo "║  npm publish does not include sibling packages in the      ║"
    echo "║  tarball, so external consumers cannot resolve the path.   ║"
    echo "║  This is the bug class that broke 0.11.0 and 0.11.1.       ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "$BAD_IMPORTS" | while read line; do
      printf "║    %-54s ║\n" "$line"
    done
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Fix: declare @lythos/<pkg>: workspace:* in dependencies   ║"
    echo "║  of the importing package, then:                           ║"
    echo "║    import { x } from '@lythos/<other-pkg>'                 ║"
    echo "║  See ADR-20260513041030769 for the full rule.              ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
fi

# 0.8. Private secret leak — values from .private/*.env must not appear
#      in staged content. Anything declared private was declared private
#      for a reason; if it shows up in a committable file, that's a
#      leak. Delegated to scripts/check-private-leaks.sh.
if [ -f scripts/check-private-leaks.sh ]; then
  bash scripts/check-private-leaks.sh || exit 1
fi

# 1. ADR governance checks (fast — fail early if violated)
if [ -f scripts/adr-check.sh ]; then
  bash scripts/adr-check.sh || exit 1
fi

# 2. Auto-rebuild skills when source files change in packages/**/skill/
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^packages/.*/skill/' || true)

if [ -n "$STAGED" ]; then
  echo "🛠️  Skill source files changed, rebuilding all skills..."
  bun packages/lythoskill-creator/src/cli.ts build --all

  # Stage built output so skills/ stays in sync with packages/**/skill/
  git add skills/
  echo "✅ Skills rebuilt and staged"
fi

# 2.5. Skills/ directory purity — must contain only build output, no symlinks
#      Symlinks in skills/ indicate working_set collision (agent confused
#      build output dir with deck working_set). Extraneous entries indicate
#      external skills were committed into the build output directory.
if [ -d skills/ ]; then
  SYMLINK_COUNT=0
  for link in skills/*; do
    if [ -L "$link" ]; then
      SYMLINK_COUNT=$((SYMLINK_COUNT + 1))
    fi
  done

  if [ "$SYMLINK_COUNT" -gt 0 ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ SYMLINKS IN skills/ — BUILD OUTPUT POLLUTION            ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  skills/ is the build output directory (thin pattern).       ║"
    echo "║  Symlinks here indicate deck link ran with working_set       ║"
    echo "║  pointing at skills/ — build output was overwritten.         ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    for link in skills/*; do
      if [ -L "$link" ]; then
        printf "║    %-54s ║\n" "$(basename "$link") -> $(readlink "$link")"
      fi
    done
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Fix: remove symlinks, then rebuild:                         ║"
    echo "║    rm skills/<name>  # for each symlink                      ║"
    echo "║    bunx @lythos/skill-creator build --all                    ║"
    echo "║  Ensure deck.toml working_set ≠ \"skills\"                   ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi

  # Check for extraneous entries (no corresponding packages/<name>/skill/)
  for dir in skills/*; do
    if [ -d "$dir" ]; then
      name=$(basename "$dir")
      if [ ! -d "packages/$name/skill" ]; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  ❌ EXTRANEOUS ENTRY IN skills/ — NO SOURCE PACKAGE          ║"
        echo "╠══════════════════════════════════════════════════════════════╣"
        printf "║  %-58s ║\n" "'$(basename "$dir")' in skills/ has no matching"
        printf "║  %-58s ║\n" "packages/$(basename "$dir")/skill/ source."
        echo "║  External skills belong in cold pool, not build output.      ║"
        echo "╠══════════════════════════════════════════════════════════════╣"
        echo "║  Fix: git rm -r skills/$(basename "$dir")                     ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        echo ""
        exit 1
      fi
    fi
  done
fi

# 2.6. Deck validation — validate staged examples/decks/*.toml
#      Ensures ZK-generated and manually-authored decks have required fields
#      (max_cards, valid locator paths) before they land on main.
STAGED_DECKS=$(git diff --cached --name-only --diff-filter=ACM | grep '^examples/decks/.*\.toml$' || true)

if [ -n "$STAGED_DECKS" ]; then
  DECK_ERRORS=0
  for deck in $STAGED_DECKS; do
    if ! bun packages/lythoskill-deck/src/cli.ts validate --deck "$deck"; then
      DECK_ERRORS=$((DECK_ERRORS + 1))
    fi
  done
  if [ "$DECK_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ ${DECK_ERRORS} deck(s) failed validation"
    exit 1
  fi
fi

# 3. Cortex governance: Epic-ADR coupling + lane guard + in-progress reminder (TypeScript)
#    → delegates to packages/lythoskill-project-cortex/src/hooks/pre-commit.ts (T2+T3)
bun packages/lythoskill-project-cortex/src/hooks/pre-commit.ts

# 4. Path safety: prevent path traversal via unsanitized aliases (CWE-22, ADR-202605102330)
bun scripts/check-path-safety.ts || exit 1

# 5. README version drift — must match package.json
bun scripts/check-readme-version.ts || exit 1

# 6. Test gate: run tests for changed packages, block if any fail ("测试必须 0 fail")
bun scripts/pre-commit-test.ts || exit 1
