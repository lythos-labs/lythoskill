#!/bin/sh
# Pre-commit: ADR compliance + auto-rebuild skills + cortex governance (TypeScript)

# 0. Guard-script sensitivity check — warn when modifying meta-layer guards
STAGED_GUARDS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(\.husky/|scripts/pre-commit-|scripts/test-report|scripts/check-path-safety|scripts/adr-check)' || true)

if [ -n "$STAGED_GUARDS" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  ⚠️  GUARD-SCRIPT MODIFICATION DETECTED                     ║"
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Bugs in these files cascade silently — the guard itself    ║"
  echo "║  fails and you won't know until the next incident.          ║"
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Changed:                                                   ║"
  for f in $STAGED_GUARDS; do
    printf "║    - %-54s ║\n" "$f"
  done
  echo "╠══════════════════════════════════════════════════════════════╣"
  echo "║  Before committing, QA the change:                          ║"
  echo "║    arena single --deck examples/decks/qa-sweep.toml         ║"
  echo "║    --brief 'verify <guard> catches deliberate failure'      ║"
  echo "║  See: AGENTS.md → Guard-script sensitivity                  ║"
  echo "║  Wiki: git-provenance-over-design-assumption-lesson.md      ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
fi

# 1. ADR governance checks (fast — fail early if violated)
if [ -f scripts/adr-check.sh ]; then
  bash scripts/adr-check.sh || exit 1
fi

# 2. Auto-rebuild skills when source files change in packages/**/skill/
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^packages/.*/skill/' || true)

if [ -n "$STAGED" ]; then
  echo "🛠️  Skill source files changed, rebuilding all skills..."
  bun packages/lythoskill-creator/src/cli.ts build --all

  # Stage built output so skills/ stays in sync with packages/**/skill/
  git add skills/
  echo "✅ Skills rebuilt and staged"
fi

# 3. Cortex governance: Epic-ADR coupling + lane guard + in-progress reminder (TypeScript)
#    → delegates to packages/lythoskill-project-cortex/src/hooks/pre-commit.ts (T2+T3)
bun packages/lythoskill-project-cortex/src/hooks/pre-commit.ts

# 4. Path safety: prevent path traversal via unsanitized aliases (CWE-22, ADR-202605102330)
bun scripts/check-path-safety.ts || exit 1

# 5. Test gate: run tests for changed packages, block if any fail ("测试必须 0 fail")
bun scripts/pre-commit-test.ts || exit 1
