# Dependencies
node_modules/

# OS
.DS_Store

# Logs
*.log

# Build output (legacy, now skills/ is the build target)
dist/

# Runtime config (project-local, generated by init)
.project-workflow.json

# Task ID database (if using incremental ID mode)
.task-id-db.json

# npm access token (local-only, never commit)
.npm-access

# GitHub access token (local-only, never commit)
.github-token

# Claude SDK credentials (local-only, never commit)
.claude-sdk-key

playground/
.claude/

# Private operational docs (local-only, never commit)
.private/

# Curator generated artifacts (cold pool index, regenerated at runtime)
.lythoskill-curator/

# Entropy check timestamp (local-only, survives across sessions)
.last-entropy-check

# Working sets — generated by deck link, never commit
# Defensive: prevent agent mis-commits of symlink working sets
.agents/skills/
.kimi/skills/
.cursor/skills/
.codex/skills/

# Experiment artifact lockfiles (root skill-deck.lock is committed)
.agents/skill-deck.lock
.codex/skill-deck.lock
showcase/**/skill-deck.lock

# Arena agent output leftovers (must live under playground/)
agent-output-*

# Temporary directories and files
tmp/
.tmp/
conversation-boost.txt

.husky/_
test-results/*
!test-results/README.md
runs/
cold-pool/

# VitePress site local deps
site/node_modules/
site/package-lock.json
site/.vitepress/cache/
